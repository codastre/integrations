{
	"description": "Codastre hooks: inject QUERY/GRAPH awareness into sessions and subagents, nudge away from text search, enforce the live A/B search mode, and (opt-in) log search-tool token usage for savings reports",
	"hooks": {
		"UserPromptSubmit": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/mode_prompt.js\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/inject.js\" SessionStart",
						"statusMessage": "Loading Codastre context..."
					}
				]
			}
		],
		"SubagentStart": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/inject.js\" SubagentStart"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Grep|Glob|Bash|.*codastre.*__(QUERY|GRAPH|REGISTER|SYNC)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/mode.js\""
					}
				]
			},
			{
				"matcher": "Grep|Glob",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/inject.js\" PreToolUse"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/bash.js\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Grep|Glob|Bash|Read|.*codastre.*__(QUERY|GRAPH|REGISTER|SYNC)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/track.js\""
					}
				]
			}
		]
	}
}
