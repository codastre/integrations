{
	"description": "Codastre hooks: inject QUERY/GRAPH awareness into sessions and subagents, nudge away from text search, enforce the live A/B search mode, and (opt-in) log search-tool token usage for savings reports, and record compaction / tool-failure counters locally for codastre collect, and run Tier D study sessions (pre-registered prompt injection, arm enforcement)",
	"hooks": {
		"UserPromptSubmit": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/mode_prompt.js\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/inject.js\" SessionStart",
						"statusMessage": "Loading Codastre context..."
					}
				]
			}
		],
		"SubagentStart": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/inject.js\" SubagentStart"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Grep|Glob|Bash|.*codastre.*__(QUERY|GRAPH|CORPUS_SEARCH|CONTRACTS|REGISTER|SYNC)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/mode.js\""
					}
				]
			},
			{
				"matcher": "Grep|Glob",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/inject.js\" PreToolUse"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/bash.js\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Grep|Glob|Bash|Read|.*codastre.*__(QUERY|GRAPH|CORPUS_SEARCH|CONTRACTS|REGISTER|SYNC)",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/track.js\""
					}
				]
			}
		],
		"PreCompact": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/session_events.js\" PreCompact"
					}
				]
			}
		],
		"PostCompact": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/session_events.js\" PostCompact"
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PLUGIN_ROOT/hooks/session_events.js\" PostToolUseFailure"
					}
				]
			}
		]
	}
}
